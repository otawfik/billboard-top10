       "2-4     434\n",
       "Name: count, dtype: int64"
      ]
     },
     "execution_count": 45,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# How many songs did the lead artist debut in the same week? Then put the counts into four groups.\n",
    "songs['same_artist_debuts'] = songs.groupby(['primary_artist', 'debut_date'])['title'].transform('size')\n",
    "\n",
    "songs['album_debut_bucket'] = '10+'\n",
    "songs.loc[songs['same_artist_debuts'] <= 9, 'album_debut_bucket'] = '5-9'\n",
    "songs.loc[songs['same_artist_debuts'] <= 4, 'album_debut_bucket'] = '2-4'\n",
    "songs.loc[songs['same_artist_debuts'] == 1, 'album_debut_bucket'] = '1'\n",
    "songs['album_debut_bucket'].value_counts()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "405a31e2",
   "metadata": {},
   "source": [
    "Days from release to chart debut need a full release date. MusicBrainz sometimes only knows the\n",
    "year."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "536c688b",
