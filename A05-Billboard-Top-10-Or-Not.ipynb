    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "same song twice in one week: 13\n"
     ]
    }
   ],
   "source": [
    "# Rename each later credit to the credit the song debuted under.\n",
    "for old_title, old_artist, new_title, new_artist in duplicate_credits:\n",
    "    match = (weekly['title'] == old_title) & (weekly['artist'] == old_artist)\n",
    "    weekly.loc[match, 'title'] = new_title\n",
    "    weekly.loc[match, 'artist'] = new_artist\n",
    "\n",
    "print('same song twice in one week:', weekly.duplicated(subset=['chart_date', 'title', 'artist']).sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "85a80493",
   "metadata": {
