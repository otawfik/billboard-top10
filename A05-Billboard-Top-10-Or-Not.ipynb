    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "songs from 2018 on: 5377 -> 5342\n",
      "Top 10 songs from 2018 on: 521 -> 519\n"
     ]
    }
   ],
   "source": [
    "# Build the song table again with the same steps, now that each merged song has one credit.\n",
    "songs = weekly.sort_values('chart_date').groupby(['title', 'artist']).agg(\n",
    "    debut_date=('chart_date', 'min'),\n",
    "    last_date=('chart_date', 'max'),\n",
    "    peak_position=('position', 'min'),\n",
    "    debut_position=('position', 'first'),\n",
    "    weeks_on_chart=('chart_date', 'count'),\n",
    ").reset_index()\n",
    "songs['top10'] = songs['peak_position'] <= 10\n",
    "\n",
    "songs_2018 = songs[songs['debut_date'] >= '2018-01-01']\n",
    "print('songs from 2018 on:', len(credits_2018), '->', len(songs_2018))\n",
    "print('Top 10 songs from 2018 on:', credits_2018['top10'].sum(), '->', songs_2018['top10'].sum())"
   ]
  },
