     "shell.execute_reply": "2026-10-19T00:26:35.744578Z"
    }
   },
   "outputs": [],
   "source": [
    "# Does the credit name a featured artist? Billboard sometimes misspells \"featuring\".\n",
    "feature_words = ['featuring', 'feauring', 'featauring', 'feat.', 'ft.']\n",
    "songs['has_feature'] = False\n",
    "for word in feature_words:\n",
    "    songs['has_feature'] = songs['has_feature'] | songs['artist'].str.lower().str.contains(word, regex=False)"
   ]
  },
